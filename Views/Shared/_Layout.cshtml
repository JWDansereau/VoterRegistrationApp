@using Microsoft.AspNetCore.Http

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Voter Registration Portal</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body>
    <header>
        <nav class="navbar navbar-expand-lg site-navbar">

            <div class="container">

                <!-- Brand -->
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">

                    <span class="brand-icon">
                        ✓
                    </span>

                    <span class="brand-text">
                        <strong>Voter Registration</strong>
                        <small>Online Portal</small>
                    </span>

                </a>


                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarNav"
                        aria-controls="navbarNav"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <!-- Navigation -->
                <div class="collapse navbar-collapse" id="navbarNav">

                    <ul class="navbar-nav main-nav">

                        <!-- Home -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <span class="nav-icon">⌂</span>
                                Home

                            </a>

                        </li>


                        @if (Context.Session.GetString("Role") != "Admin")
                        {
                            <!-- Register -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Registration"
                                   asp-action="Create">

                                    <span class="nav-icon">＋</span>
                                    Register to Vote

                                </a>

                            </li>


                            <!-- Status -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Registration"
                                   asp-action="Status">

                                    <span class="nav-icon">✓</span>
                                    Check Status

                                </a>

                            </li>
                        }


                        @if (Context.Session.GetString("Role") == "Admin")
                        {
                            <!-- Admin -->
                            <li class="nav-item">

                                <a class="nav-link admin-nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">

                                    <span class="nav-icon">⚙</span>
                                    Admin Dashboard

                                </a>

                            </li>


                            <!-- Registrations -->
                            <li class="nav-item">

                                <a class="nav-link"
                                   asp-controller="Registration"
                                   asp-action="Index">

                                    <span class="nav-icon">▤</span>
                                    Registrations

                                </a>

                            </li>
                        }

                    </ul>


                    <!-- Account Area -->
                    <ul class="navbar-nav account-nav ms-auto">

                        @if (Context.Session.GetString("User") != null)
                        {
                            <!-- Logged In User -->
                            <li class="nav-item">

                                <div class="user-display">

                                    <span class="user-avatar">
                                        @(Context.Session.GetString("User")?.Substring(0, 1).ToUpper())
                                    </span>

                                    <span class="user-name">
                                        @Context.Session.GetString("User")
                                    </span>

                                </div>

                            </li>

                            <!-- Logout -->
                            <li class="nav-item">

                                <a class="nav-link logout-link"
                                   asp-controller="Account"
                                   asp-action="Logout">

                                    Logout

                                </a>

                            </li>
                        }
                        else
                        {
                            <!-- Login -->
                            <li class="nav-item">

                                <a class="nav-link login-link"
                                   asp-controller="Account"
                                   asp-action="Login">

                                    Login

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

        </nav>
    </header>

    <div class="container mt-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>